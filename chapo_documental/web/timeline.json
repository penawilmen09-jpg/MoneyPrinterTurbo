 "subs": [
  {
   "a": 4.25,
   "b": 5.4,
   "text": "[[11 DE JULIO DE 2015.]]"
  },
  {
   "a": 5.45,
   "b": 9.45,
   "text": "Un acontecimiento inesperado estaba a punto de cambiar la historia de una de las prisiones más vigiladas de [[México]]."
  },
  {
   "a": 9.85,
   "b": 14.62,
   "text": "[[Joaquín Guzmán Loera]] estaba detenido en el penal de máxima seguridad del [[Altiplano]]."
  },
  {
   "a": 15.15,
   "b": 21.01,
   "text": "A las [[20:52]] fue visto por última vez acercándose al área de las [[regaderas]]."
  },
  {
   "a": 21.47,
   "b": 24.29,
   "text": "Los custodios descubrieron que había [[desaparecido]]."
  },
  {
   "a": 24.43,
   "b": 27.41,
   "text": "Debajo de la ducha encontraron una [[abertura]] que conducía a un [[túnel]]."
  },
  {
   "a": 27.87,
   "b": 31.25,
   "text": "El túnel tenía más de [[un kilómetro]] de longitud"
  },
  {
   "a": 31.39,
   "b": 35.41,
   "text": "y contaba con [[iluminación]], [[ventilación]] y una [[motocicleta sobre rieles]]."
  },
  {
   "a": 35.87,
   "b": 38.85,
   "text": "El túnel terminaba en una [[construcción]] situada fuera del penal."
  },
  {
   "a": 38.99,
   "b": 41.81,
   "text": "Por allí consiguió [[escapar]]."
  },
  {
   "a": 42.26,
   "b": 47.22,
   "text": "La fuga provocó una [[movilización nacional]] para encontrar al prisionero."
  },
  {
   "a": 47.55,
   "b": 50.1,
   "text": "PERO SU LIBERTAD DURÓ SOLO [[SEIS MESES]]..."
  },
  {
   "a": 50.5,
   "b": 55.0,
   "text": "EL [[8 DE ENERO DE 2016]] FUE [[CAPTURADO]] NUEVAMENTE"
  },
  {
   "a": 55.7,
   "b": 58.7,
   "text": "¿QUÉ OTRA [[HISTORIA REAL]] DEBERÍAMOS CONTAR?",
   "big": true
  }
 ],
