 "clauses": [
  {
   "scene": 0,
   "text": "Hace más de veinte mil años,",
   "start": 0.55,
   "end": 2.6189342403628117
  },
  {
   "scene": 0,
   "text": "enormes glaciares cubrían gran parte del planeta.",
   "start": 2.8689342403628117,
   "end": 5.949387755102041
  },
  {
   "scene": 0,
   "text": "El frío extremo ponía a prueba a cada ser humano.",
   "start": 6.449387755102041,
   "end": 9.512721088435374
  },
  {
   "scene": 1,
   "text": "Para resistir, cazaban mamuts,",
   "start": 10.812721088435374,
   "end": 12.838412698412698
  },
  {
   "scene": 1,
   "text": "y con sus pieles confeccionaban abrigos gruesos.",
   "start": 13.088412698412698,
   "end": 16.02374149659864
  },
  {
   "scene": 1,
   "text": "Los huesos se convertían en herramientas.",
   "start": 16.473741496598638,
   "end": 18.983990929705215
  },
  {
   "scene": 2,
   "text": "El fuego lo cambió todo.",
   "start": 20.812721088435374,
   "end": 22.407596371882086
  },
  {
   "scene": 2,
   "text": "Les daba calor y luz,",
   "start": 22.857596371882085,
   "end": 24.450612244897957
  },
  {
   "scene": 2,
   "text": "alejaba a las fieras,",
   "start": 24.650612244897957,
   "end": 26.048934240362808
  },
  {
   "scene": 2,
   "text": "y permitía cocinar los alimentos.",
   "start": 26.248934240362807,
   "end": 28.541768707482987
  },
  {
   "scene": 3,
   "text": "Cuando llegaban las tormentas,",
   "start": 30.812721088435367,
   "end": 32.74072562358276
  },
  {
   "scene": 3,
   "text": "se refugiaban en cuevas,",
   "start": 32.99072562358276,
   "end": 34.586349206349205
  },
  {
   "scene": 3,
   "text": "o levantaban tiendas con huesos y pieles.",
   "start": 34.78634920634921,
   "end": 37.41968253968254
  },
  {
   "scene": 4,
   "text": "Su mayor fortaleza era la comunidad.",
   "start": 40.81269841269841,
   "end": 43.27662131519274
  },
  {
   "scene": 4,
   "text": "Compartían la comida,",
   "start": 43.726621315192745,
   "end": 45.24770975056689
  },
  {
   "scene": 4,
   "text": "cuidaban a los niños,",
   "start": 45.447709750566894,
   "end": 46.89884353741497
  },
  {
   "scene": 4,
   "text": "y transmitían su sabiduría junto a la hoguera.",
   "start": 47.09884353741497,
   "end": 49.85428571428572
  },
  {
   "scene": 5,
   "text": "Gracias a su ingenio, su unión y su valentía,",
   "start": 51.15428571428572,
   "end": 53.9614739229025
  },
  {
   "scene": 5,
   "text": "la humanidad superó el hielo.",
   "start": 54.261473922902496,
   "end": 56.151269841269844
  },
  {
   "scene": 5,
   "text": "Y así, comenzó nuestra historia.",
   "start": 56.651269841269844,
   "end": 58.615147392290254
  }
 ],
